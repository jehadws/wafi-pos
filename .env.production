APP_NAME="Subul POS"
APP_ENV=production
# Deliberately empty: the installer generates one key per terminal during setup
# (installer/setup.iss). A shared key baked into the bundle would be the same
# encryption key on every customer machine.
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=error

# Enabled by default and writes a row per request, which on a POS terminal
# grows without bound inside the ProgramData database.
TELESCOPE_ENABLED=false

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_PREFIX=sb_

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_DOMAIN=127.0.0.1
SESSION_COOKIE=subul_desktop_session

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=database
CACHE_STORE=database

REVERB_APP_ID=subul-pos
REVERB_APP_KEY=subul-local-key
REVERB_APP_SECRET=subul-local-secret
REVERB_SERVER_HOST=127.0.0.1
REVERB_HOST=127.0.0.1
REVERB_PORT=6001
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000
REACT_APP_USE_NEW_POS_MANAGER=true
SB_ENV=production
